<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">

<dictionary title="SwiftTag Terminology">

    <suite name="Standard Suite" code="core" description="Common classes and commands for all applications.">

        <enumeration name="save options" code="savo">
            <enumerator name="yes" code="yes " description="Save the file."/>
            <enumerator name="no" code="no  " description="Do not save the file."/>
            <enumerator name="ask" code="ask " description="Ask the user whether or not to save the file."/>
        </enumeration>

        <enumeration name="save scope options" code="svso">
            <enumerator name="all" code="altr" description="Save all editable tracks in an editor window."/>
            <enumerator name="selected" code="sltr" description="Save selected editable tracks in an editor window."/>
        </enumeration>

        <enumeration name="save payload options" code="svpo">
            <enumerator name="tags only" code="tgos" description="Save editable track tags in an editor window."/>
            <enumerator name="pictures only" code="pcos" description="Save editable track pictures in an editor window."/>
            <enumerator name="tags and pictures" code="tpos" description="Save editable track tags and pictures in an editor window."/>
        </enumeration>

        <command name="open" code="aevtodoc" description="Open a document.">
            <direct-parameter description="The file(s) to open.">
                <type type="file"/>
                <type type="file" list="yes"/>
            </direct-parameter>
            <result description="The opened document(s).">
                <type type="document"/>
                <type type="document" list="yes"/>
            </result>
        </command>

        <command name="close" code="coreclos" description="Close a document or editor window.">
            <cocoa class="NSCloseCommand"/>
            <access-group identifier="*"/>
            <direct-parameter type="specifier" requires-access="r" description="The document(s) or window(s) to close."/>
            <parameter name="saving" code="savo" type="save options" optional="yes" description="Should changes be saved before closing?">
                <cocoa key="SaveOptions"/>
            </parameter>
            <parameter name="saving in" code="kfil" type="file" optional="yes" description="The file in which to save the document, if so.">
                <cocoa key="File"/>
            </parameter>
            <parameter name="saving scope" code="svso" type="save scope options" optional="yes" description="The track selection scope of the save operation.">
                <cocoa key="SaveScopeOptions"/>
            </parameter>
            <parameter name="saving payload" code="svpo" type="save payload options" optional="yes" description="The track payload of the save operation.">
                <cocoa key="SavePayloadOptions"/>
            </parameter>
        </command>

        <command name="save" code="coresave" description="Save a document or editor window.">
            <access-group identifier="*"/>
            <direct-parameter type="specifier" requires-access="r" description="The document(s) or window(s) to save."/>
            <parameter name="in" code="kfil" type="file" optional="yes" description="The file in which to save the document.">
                <cocoa key="File"/>
            </parameter>
            <parameter name="with scope" code="svso" type="save scope options" optional="yes" description="The track selection scope of the save operation.">
                <cocoa key="SaveScopeOptions"/>
            </parameter>
            <parameter name="with payload" code="svpo" type="save payload options" optional="yes" description="The track payload of the save operation.">
                <cocoa key="SavePayloadOptions"/>
            </parameter>
        </command>

        <command name="count" code="corecnte" description="Return number of elements of specific class within object.">
            <cocoa class="NSCountCommand"/>
            <access-group identifier="*"/>
            <direct-parameter type="specifier" requires-access="r" description="Objects to be counted."/>
            <parameter name="each" code="kocl" type="type" optional="yes" description="Class of objects to be counted." hidden="yes">
                <cocoa key="ObjectClass"/>
            </parameter>
            <result type="integer" description="Count."/>
        </command>

        <command name="delete" code="coredelo" description="Delete object.">
            <cocoa class="SwiftTagDeleteCommand"/>
            <access-group identifier="*"/>
            <direct-parameter type="specifier" description="Object(s) to delete."/>
        </command>

        <command name="exists" code="coredoex" description="Verify object exists.">
            <cocoa class="NSExistsCommand"/>
            <access-group identifier="*"/>
            <direct-parameter type="any" requires-access="r" description="Object to check."/>
            <result type="boolean" description="Whether object exists."/>
        </command>

        <command name="make" code="corecrel" description="Create new object.">
            <cocoa class="SwiftTagCreateCommand"/>
            <access-group identifier="*"/>
            <parameter name="new" code="kocl" type="type" description="Class of new object.">
                <cocoa key="ObjectClass"/>
            </parameter>
            <parameter name="at" code="insh" type="location specifier" optional="yes" description="Location at which to insert object.">
                <cocoa key="Location"/>
            </parameter>
            <parameter name="with data" code="data" type="any" optional="yes" description="Initial contents of object.">
                <cocoa key="ObjectData"/>
            </parameter>
            <parameter name="with properties" code="prdt" type="record" optional="yes" description="Initial property values.">
                <cocoa key="KeyDictionary"/>
            </parameter>
            <result type="specifier" description="New object."/>
        </command>

        <command name="move" code="coremove" description="Move object to new location.">
            <cocoa class="NSMoveCommand"/>
            <access-group identifier="*"/>
            <direct-parameter type="specifier" requires-access="r" description="Object(s) to move."/>
            <parameter name="to" code="insh" type="location specifier" description="New location for the object(s).">
                <cocoa key="ToLocation"/>
            </parameter>
        </command>

        <command name="quit" code="aevtquit" description="Quit application.">
            <cocoa class="NSQuitCommand"/>
        </command>

        <class name="document" plural="documents" code="docu" description="A SwiftTag document.">
            <cocoa class="SwiftTagScriptDocument"/>
            <property name="file" code="file" type="file" access="r" description="Its location on disk, if it has one.">
                <cocoa key="fileURL"/>
            </property>
            <property name="modified" code="imod" type="boolean" access="r" description="Has it been modified since the last save?">
                <cocoa key="modified"/>
            </property>
            <property name="name" code="pnam" type="text" access="r" description="Its name.">
                <cocoa key="name"/>
            </property>
            <responds-to command="save">
                <cocoa method="handleSaveScriptCommand:"/>
            </responds-to>
            <responds-to command="close">
                <cocoa method="handleCloseScriptCommand:"/>
            </responds-to>
        </class>

    </suite>

    <suite name="SwiftTag Suite" code="SwTG" description="SwiftTag-specific classes and commands.">

        <enumeration name="flac picture type" code="pcty">
            <enumerator name="other" code="othe" description="A other image of the track."/>
            <enumerator name="PNG icon" code="pngi" description="The 32x32 PNG icon image of the track."/>
            <enumerator name="other icon" code="othi" description="The other icon image of the track."/>
            <enumerator name="front cover" code="frcv" description="A front cover image of the track."/>
            <enumerator name="back cover" code="bckc" description="A back cover image of the track."/>
            <enumerator name="leaflet" code="leaf" description="A leaflet image of the track."/>
            <enumerator name="media" code="medi" description="A media image of the track."/>
            <enumerator name="lead artist" code="lead" description="A lead artist image of the track."/>
            <enumerator name="artist" code="arti" description="An artist image of the track."/>
            <enumerator name="conductor" code="cond" description="A conductor image of the track."/>
            <enumerator name="band" code="band" description="A band image of the track."/>
            <enumerator name="composer" code="comp" description="A composer image of the track."/>
            <enumerator name="lyricist" code="lyri" description="A lyricist image of the track."/>
            <enumerator name="location" code="locn" description="A recording studio or location image of the track."/>
            <enumerator name="session" code="sess" description="A recording session image of the track."/>
            <enumerator name="performance" code="perf" description="A performance image of the track."/>
            <enumerator name="capture" code="capt" description="A capture from movie or video image of the track."/>
            <enumerator name="brightly colored fish" code="fish" description="A brightly colored fish image of the track."/>
            <enumerator name="illustration" code="illu" description="An illustration image of the track."/>
            <enumerator name="band logo" code="logo" description="A band logo image of the track."/>
            <enumerator name="publisher logo" code="pubo" description="A publisher logo image of the track."/>
        </enumeration>

        <enumeration name="track total key setting" code="ttks">
            <enumerator name="TOTALTRACKS" code="tott" description="Save track count with tag key TOTALTRACKS."/>
            <enumerator name="TRACKTOTAL" code="ttot" description="Save track count with tag key TRACKTOTAL."/>
            <enumerator name="TOTALTRACKS and TRACKTOTAL" code="tatt" description="Save track count with both tag keys TOTALTRACKS and TRACKTOTAL."/>
        </enumeration>

        <enumeration name="disc total key setting" code="dtks">
            <enumerator name="TOTALDISCS" code="dott" description="Save disc count with tag key TOTALDISCS."/>
            <enumerator name="DISCTOTAL" code="dtot" description="Save disc count with tag key DISCTOTAL."/>
            <enumerator name="TOTALDISCS and DISCTOTAL" code="datt" description="Save disc count with both tag keys TOTALDISCS and DISCTOTAL."/>
        </enumeration>

        <enumeration name="save notifications setting" code="snse">
            <enumerator name="always" code="snda" description="Send save notifications always."/>
            <enumerator name="when not frontmost" code="sndn" description="Send save notifications when SwiftTag application is not frontmost."/>
            <enumerator name="never" code="sndv" description="Never send save notifications."/>
        </enumeration>

        <enumeration name="theme setting" code="thse">
            <enumerator name="light" code="lght" description="Use light theme."/>
            <enumerator name="dark" code="dark" description="Use dark theme."/>
            <enumerator name="system" code="sysp" description="Use system theme."/>
        </enumeration>

        <value-type name="data" code="tdta" description="Raw binary data.">
            <cocoa class="NSData"/>
        </value-type>

        <record-type name="color" code="colr" description="A color value in RGBA color space (values 0-1.0).">
            <property name="red" code="redc" type="real" description="The red component value (0-1.0).">
                <cocoa key="red"/>
            </property>
            <property name="green" code="grec" type="real" description="The green component value (0-1.0).">
                <cocoa key="green"/>
            </property>
            <property name="blue" code="bluc" type="real" description="The blue component value (0-1.0).">
                <cocoa key="blue"/>
            </property>
            <property name="alpha" code="alph" type="real" description="The alpha component value (0-1.0).">
                <cocoa key="alpha"/>
            </property>
        </record-type>

        <command name="add" code="SwTGaddt" description="Add one or more FLAC files to an editor window.">
            <direct-parameter description="The FLAC file(s) to add.">
                <type type="file"/>
                <type type="file" list="yes"/>
            </direct-parameter>
            <parameter name="to" code="insh" optional="yes" description="The editor window that should receive the added file(s).">
                <cocoa key="Target"/>
                <type type="editor window"/>
            </parameter>
            <result description="Reference to the added track(s).">
                <type type="track"/>
                <type type="track" list="yes"/>
            </result>
        </command>

        <command name="import picture" code="SwTGimpt" description="Import image data as a track picture.">
            <cocoa class="SwiftTagImportPictureCommand"/>
            <direct-parameter type="any" optional="yes" description="The image data to import. SwiftTag validates that it resolves to binary image data."/>
            <parameter name="with data" code="pdat" type="any" optional="yes" description="The image data to import. SwiftTag validates that it resolves to binary image data.">
                <cocoa key="PictureData"/>
            </parameter>
            <parameter name="with picture type" code="pcty" type="flac picture type" optional="yes" description="The FLAC picture type. Defaults to front cover when omitted.">
                <cocoa key="PictureType"/>
            </parameter>
            <parameter name="with description" code="tdsc" type="text" optional="yes" description="The picture description. If omitted, SwiftTag preserves an existing duplicate description or uses the default description for the picture type.">
                <cocoa key="Description"/>
            </parameter>
            <parameter name="with MIME type" code="mime" type="text" optional="yes" description="An optional MIME type hint. SwiftTag prefers the MIME type derived from the image data when it can be determined.">
                <cocoa key="MimeType"/>
            </parameter>
            <result type="picture" description="The imported or matched track picture."/>
        </command>

        <class name="application" plural="applications" code="capp" description="Application program.">
            <cocoa class="NSApplication"/>
            <element type="document">
                <cocoa key="scriptDocuments"/>
            </element>
            <element type="editor window">
                <cocoa key="scriptEditorWindows"/>
            </element>
            <element type="track">
                <cocoa key="scriptTracks"/>
            </element>
            <property name="track save scope" code="svso" type="save scope options" access="rw" description="The track selection scope of a save operation (aka: FLAC File Save (⌘S): Write).">
                <cocoa key="SaveScopeOptionsSetting"/>
            </property>
            <property name="track save payload" code="svpo" type="save payload options" access="rw" description="The track save payload of a save operation (aka: FLAC File Save (⌘S): To).">
                <cocoa key="SavePayloadOptionsSetting"/>
            </property>
            <property name="save referenced document" code="svrd" type="boolean" access="rw" description="Save editor window's referenced document on save operation (aka: SwiftTag Document Save (⌘S): Save referenced document).">
                <cocoa key="SaveReferencedDocumentSetting"/>
            </property>
            <property name="ask to save new document" code="asnd" type="boolean" access="rw" description="Ask to save new document on save operation when editor window does not have a referenced document (aka: SwiftTag Document Save (⌘S): Ask to save new documents).">
                <cocoa key="AskToSaveNewDocumentSetting"/>
            </property>
            <property name="zero pad track numbers" code="zptn" type="boolean" access="rw" description="Zero pad track number/total on save operation (aka: Value preferences: Zero pad Track Number/Total).">
                <cocoa key="ZeroPadTrackNumbersSetting"/>
            </property>
            <property name="zero pad disc numbers" code="zpdn" type="boolean" access="rw" description="Zero pad disc number/total on save operation (aka: Value preferences: Zero pad Disc Number/Total).">
                <cocoa key="ZeroPadDiscNumbersSetting"/>
            </property>
            <property name="track total key" code="ttks" type="track total key setting" access="rw" description="Track total key preference (aka: Key preferences: Write Track Total key).">
                <cocoa key="TrackTotalKeySetting"/>
            </property>
            <property name="disc total key" code="dtks" type="disc total key setting" access="rw" description="Disc total key preference (aka: Key preferences: Write Disc Total key).">
                <cocoa key="DiscTotalKeySetting"/>
            </property>
            <property name="auto update track total" code="autt" type="boolean" access="rw" description="Automatically update track total based on track table count (aka: Track Total/Compilation Management: Auto update Track Total).">
                <cocoa key="AutoUpdateTrackTotalSetting"/>
            </property>
            <property name="apply compilation to all tracks" code="apct" type="boolean" access="rw" description="Apply compilation setting to all tracks (aka: Track Total/Compilation Management: Apply Compilation to all Tracks).">
                <cocoa key="ApplyCompilationToAllTracksSetting"/>
            </property>
            <property name="save front cover to all tracks" code="sfct" type="boolean" access="rw" description="Save front cover(s) to all tracks (aka: Picture Management: Save Front Cover to all Tracks).">
                <cocoa key="SaveFrontCoverToAllTracksSetting"/>
            </property>
            <property name="save all pictures to all tracks" code="sapt" type="boolean" access="rw" description="Save all pictures to all tracks (aka: Picture Management: Save all Pictures to all Tracks).">
                <cocoa key="SaveAllPicturesToAllTracksSetting"/>
            </property>
            <property name="send save notifications" code="snse" type="save notifications setting" access="rw" description="Send save notifications preference (aka: Send Save Notifications).">
                <cocoa key="SendSaveNotificationsSetting"/>
            </property>
            <property name="theme" code="thse" type="theme setting" access="rw" description="Theme preference (aka: Theme).">
                <cocoa key="ThemeSetting"/>
            </property>
            <property name="track to track diff color" code="ttdc" type="color" access="rw" description="Track to track diff color preference (aka: Tag Value Difference Colors: Track to Track Diff Color).">
                <cocoa key="TrackToTrackDiffColorSetting"/>
            </property>
            <property name="track to file diff color" code="ttfd" type="color" access="rw" description="Track to file diff color preference (aka: Tag Value Difference Colors: Track to File Diff Color).">
                <cocoa key="TrackToFileDiffColorSetting"/>
            </property>
            <property name="externally modified diff color" code="emdc" type="color" access="rw" description="Externally modified diff color preference (aka: Tag Value Difference Colors: Externally Modified Diff Color).">
                <cocoa key="ExternallyModifiedDiffColorSetting"/>
            </property>
            <property name="track and disc total mismatch color" code="tddc" type="color" access="rw" description="Track/disc total mismatch color preference (aka: Tag Value Difference Colors: Track/Disc Total Mismatch Color).">
                <cocoa key="TrackAndDiscTotalMismatchColorSetting"/>
            </property>
            <property name="picture status overlay color" code="psoc" type="color" access="rw" description="Picture status overlay color preference (aka: Tag Value Difference Colors: Picture Status Overlay Color).">
                <cocoa key="PictureStatusOverlayColorSetting"/>
            </property>
            <property name="format on track to file diff" code="ftfd" type="boolean" access="rw" description="Perform text formatting on track to file diff (aka: Diff Tools: Format on Track to File Diff).">
                <cocoa key="FormatOnTrackToFileDiffSetting"/>
            </property>
            <property name="format on track to track diff" code="fttd" type="boolean" access="rw" description="Perform text formatting on track to track diff (aka: Diff Tools: Format on Track to Track Diff).">
                <cocoa key="FormatOnTrackToTrackDiffSetting"/>
            </property>
            <property name="format on externally modified diff" code="ftem" type="boolean" access="rw" description="Perform text formatting on externally modified diff (aka: Diff Tools: Format on Externally Modified Diff).">
                <cocoa key="FormatOnExternallyModifiedDiffSetting"/>
            </property>
            <property name="format on track total mismatch" code="fttm" type="boolean" access="rw" description="Perform text formatting on track total mismatch (aka: Diff Tools: Format on Track Total Mismatch).">
                <cocoa key="FormatOnTrackTotalMismatchSetting"/>
            </property>
            <property name="format on disc total mismatch" code="ftdm" type="boolean" access="rw" description="Perform text formatting on disc total mismatch (aka: Diff Tools: Format on Disc Total Mismatch).">
                <cocoa key="FormatOnDiscTotalMismatchSetting"/>
            </property>
            <property name="format on duplicate picture" code="fodp" type="boolean" access="rw" description="Show color overlay on duplicate picture (aka: Diff Tools: Format on Duplicate Picture).">
                <cocoa key="FormatOnDuplicatePictureSetting"/>
            </property>
            <responds-to command="add">
                <cocoa method="handleAddTracksScriptCommand:"/>
            </responds-to>
            <responds-to command="open">
                <cocoa method="handleOpenScriptCommand:"/>
            </responds-to>
            <responds-to command="make">
                <cocoa method="handleMakeScriptCommand:"/>
            </responds-to>
            <responds-to command="import picture">
                <cocoa method="handleImportPictureScriptCommand:"/>
            </responds-to>
            <responds-to command="quit">
                <cocoa method="handleQuitScriptCommand:"/>
            </responds-to>
        </class>

        <class name="editor window" plural="editor windows" code="edtw" description="A SwiftTag editor window.">
            <cocoa class="SwiftTagScriptEditorWindow"/>
            <element type="track">
                <cocoa key="tracks"/>
            </element>
            <property name="document" code="docu" type="document" access="r" description="Editor window document.">
                <cocoa key="document"/>
            </property>
            <property name="name" code="pnam" type="text" access="r" description="Window title.">
                <cocoa key="name"/>
            </property>
            <property name="selected tracks" code="selt" access="rw" description="Currently selected tracks in editor window.">
                <cocoa key="selectedTracks"/>
                <type type="specifier"/>
                <type type="track" list="yes"/>
            </property>
            <property name="window id" code="ewid" type="text" access="r" description="Window UUID.">
                <cocoa key="windowID"/>
            </property>
            <responds-to command="add">
                <cocoa method="handleAddTracksScriptCommand:"/>
            </responds-to>
            <responds-to command="save">
                <cocoa method="handleSaveScriptCommand:"/>
            </responds-to>
            <responds-to command="close">
                <cocoa method="handleCloseScriptCommand:"/>
            </responds-to>
        </class>

        <class name="track" plural="tracks" code="trck" description="A FLAC track file.">
            <cocoa class="SwiftTagScriptTrack"/>
            <element type="tag" access="rw">
                <cocoa key="tags"/>
            </element>
            <element type="picture" access="rw">
                <cocoa key="pictures"/>
            </element>
            <property name="album" code="albm" type="text" description="The album name of the track.">
                <cocoa key="album"/>
            </property>
            <property name="album artist" code="aart" type="text" description="The album artist of the track.">
                <cocoa key="albumArtist"/>
            </property>
            <property name="artist" code="arts" type="text" description="The artist/source of the track.">
                <cocoa key="artist"/>
            </property>
            <property name="bits per sample" code="btps" type="integer" access="r" description="The bits per sample of the track.">
                <cocoa key="bitsPerSample"/>
            </property>
            <property name="channels" code="chnl" type="integer" access="r" description="The number of sound channels of the track.">
                <cocoa key="channels"/>
            </property>
            <property name="comment" code="cmnt" type="text" description="Notes about the track.">
                <cocoa key="comment"/>
            </property>
            <property name="compilation" code="cpil" type="boolean" description="Is this track from a compilation album?">
                <cocoa key="compilation"/>
            </property>
            <property name="composer" code="cmps" type="text" description="The composer of the track.">
                <cocoa key="composer"/>
            </property>
            <property name="copyright" code="cprt" type="text" description="The copyright of the track.">
                <cocoa key="copyright"/>
            </property>
            <property name="date" code="rdat" type="date" description="The release date of track.">
                <cocoa key="releaseDate"/>
            </property>
            <property name="description" code="tdsc" type="text" description="The description of the track.">
                <cocoa key="trackDescription"/>
            </property>
            <property name="director" code="drct" type="text" description="The director(s) of the track.">
                <cocoa key="director"/>
            </property>
            <property name="disc count" code="dcnt" type="integer" description="The total number of discs in the source album.">
                <cocoa key="discCount"/>
            </property>
            <property name="disc number" code="dnbr" type="integer" description="The index of the disc containing this track on the source album.">
                <cocoa key="discNumber"/>
            </property>
            <property name="duration" code="dura" type="real" access="r" description="The length of the track in seconds.">
                <cocoa key="duration"/>
            </property>
            <property name="encoded by" code="encb" type="text" description="Track audio encoded by.">
                <cocoa key="encodedBy"/>
            </property>
            <property name="encoded using" code="encu" type="text" description="Track audio encoded using.">
                <cocoa key="encodedUsing"/>
            </property>
            <property name="encoder" code="encr" type="text" description="Track audio encoder.">
                <cocoa key="encoder"/>
            </property>
            <property name="encoder options" code="enco" type="text" description="Track audio encoder options used.">
                <cocoa key="encoderOptions"/>
            </property>
            <property name="file" code="file" type="file" access="r" description="FLAC file location on disk.">
                <cocoa key="fileURL"/>
            </property>
            <property name="fingerprint" code="fgpr" type="text" access="r" description="The track tags and pictures SHA256 hash.">
                <cocoa key="fingerprint"/>
            </property>
            <property name="FLAC fingerprint" code="ffpr" type="text" access="r" description="The track audio MD5 hash.">
                <cocoa key="flacFingerprint"/>
            </property>
            <property name="genre" code="genr" type="text" description="The music/audio genre (category) of the track.">
                <cocoa key="genre"/>
            </property>
            <property name="ISRC" code="isrc" type="text" description="The ISRC number of the track.">
                <cocoa key="isrc"/>
            </property>
            <property name="license" code="lice" type="text" description="License information for track.">
                <cocoa key="license"/>
            </property>
            <property name="lineage" code="ling" type="text" description="The lineage of the track.">
                <cocoa key="lineage"/>
            </property>
            <property name="location" code="locn" type="text" description="Recording/performance location/venue of the track.">
                <cocoa key="location"/>
            </property>
            <property name="narrator" code="narr" type="text" description="The narrator(s) of the track.">
                <cocoa key="narrator"/>
            </property>
            <property name="performer" code="perf" type="text" description="The performer(s) of the track.">
                <cocoa key="performer"/>
            </property>
            <property name="producer" code="prod" type="text" description="The producer(s) of the track.">
                <cocoa key="producer"/>
            </property>
            <property name="rating" code="rate" type="integer" description="The rating of the track.">
                <cocoa key="rating"/>
            </property>
            <property name="replay album gain" code="ragn" type="text" description="Adjusts gain of all tracks on entire album.">
                <cocoa key="replayAlbumGain"/>
            </property>
            <property name="replay album peak" code="rapk" type="text" description="Adjusts maximum peak of all tracks on entire album.">
                <cocoa key="replayAlbumPeak"/>
            </property>
            <property name="replay track gain" code="rtgn" type="text" description="Adjusts individual track volume.">
                <cocoa key="replayTrackGain"/>
            </property>
            <property name="replay track peak" code="rtpk" type="text" description="Adjusts individual track volume to prevent clipping.">
                <cocoa key="replayTrackPeak"/>
            </property>
            <property name="sample rate" code="srat" type="text" access="r" description="The sample rate of the track.">
                <cocoa key="sampleRate"/>
            </property>
            <property name="sort album" code="salb" type="text" description="Override string to use for the track when sorting by album.">
                <cocoa key="sortAlbum"/>
            </property>
            <property name="sort album artist" code="saar" type="text" description="Override string to use for the track when sorting by album artist.">
                <cocoa key="sortAlbumArtist"/>
            </property>
            <property name="sort artist" code="sart" type="text" description="Override string to use for the track when sorting by artist.">
                <cocoa key="sortArtist"/>
            </property>
            <property name="sort composer" code="scmp" type="text" description="Override string to use for the track when sorting by composer.">
                <cocoa key="sortComposer"/>
            </property>
            <property name="sort title" code="sttl" type="text" description="Override string to use for the track when sorting by title/name.">
                <cocoa key="sortTitle"/>
            </property>
            <property name="source" code="srce" type="text" description="The source of the track (CD, SBD, etc.).">
                <cocoa key="source"/>
            </property>
            <property name="title" code="titl" type="text" description="The title/name of the track.">
                <cocoa key="title"/>
            </property>
            <property name="total samples" code="tsmp" type="real" access="r" description="The total number of samples for a single channel of the track.">
                <cocoa key="totalSamples"/>
            </property>
            <property name="track count" code="tcnt" type="integer" description="The total number of tracks on the source album.">
                <cocoa key="trackCount"/>
            </property>
            <property name="track number" code="tnbr" type="integer" description="The index of the track on the source album.">
                <cocoa key="trackNumber"/>
            </property>
            <property name="vendor" code="vend" type="text" description="The vendor of the track.">
                <cocoa key="vendor"/>
            </property>
            <property name="version" code="tver" type="text" description="The version of the track.">
                <cocoa key="trackVersion"/>
            </property>
            <responds-to command="make">
                <cocoa method="handleMakeScriptCommand:"/>
            </responds-to>
            <responds-to command="import picture">
                <cocoa method="handleImportPictureScriptCommand:"/>
            </responds-to>
        </class>

        <class name="picture" plural="pictures" code="fpic" description="A FLAC track picture.">
            <cocoa class="SwiftTagScriptPicture"/>
            <contents type="data" description="The raw image data in bytes. Accepted as picture data when making or importing a new picture.">
                <cocoa key="data"/>
            </contents>
            <property name="picture type" code="pcty" type="flac picture type" in-properties="yes" description="The FLAC track file picture type. Accepted when making or importing a new picture; defaults to front cover when omitted.">
                <cocoa key="pictureType"/>
            </property>
            <property name="MIME type" code="mime" type="text" access="r" in-properties="yes" description="The format of the image data. Accepted when making or importing a new picture as a hint, but SwiftTag uses the value derived from image data when it can be determined.">
                <cocoa key="mimeType"/>
            </property>
            <property name="description" code="tdsc" type="text" access="rw" description="A UTF-8 text string describing the image.">
                <cocoa key="pictureDescription"/>
            </property>
            <property name="width" code="wdth" type="integer" access="r" in-properties="yes" description="The image width dimension in pixels. SwiftTag derives this value from image data when making or importing a picture.">
                <cocoa key="width"/>
            </property>
            <property name="height" code="hght" type="integer" access="r" in-properties="yes" description="The image height dimension in pixels. SwiftTag derives this value from image data when making or importing a picture.">
                <cocoa key="height"/>
            </property>
            <property name="color depth" code="cdpt" type="integer" access="r" in-properties="yes" description="The image color depth in bits per pixel. SwiftTag derives this value from image data when making or importing a picture.">
                <cocoa key="colorDepth"/>
            </property>
            <property name="colors" code="cols" type="integer" access="r" in-properties="yes" description="The number of colors for indexed palettes (0 for non-indexed). SwiftTag derives this value from image data when making or importing a picture.">
                <cocoa key="colors"/>
            </property>
            <property name="data" code="pcda" type="data" access="rw" in-properties="yes" description="The raw image data in bytes. Accepted when making or importing a new picture; changing it derives MIME type and dimensions from the new data.">
                <cocoa key="data"/>
            </property>
        </class>

        <class name="tag" plural="tags" code="ftag" description="A FLAC track metadata tag.">
            <cocoa class="SwiftTagScriptTag"/>
            <property name="id" code="ID  " type="text" access="r" description="The unique identifier of the tag, equal to its normalized key.">
                <cocoa key="id"/>
            </property>
            <property name="key" code="pkey" type="text" description="A FLAC track metadata tag name.">
                <cocoa key="key"/>
            </property>
            <property name="value" code="pval" type="text" description="The value associated with a FLAC track metadata key.">
                <cocoa key="value"/>
            </property>
        </class>

    </suite>

</dictionary>
